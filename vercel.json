{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?route=:route*"
    },
    {
      "source": "/api/bot/:route*",
      "destination": "/api/bot?route=:route*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...slug]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/bot.js": {
      "maxDuration": 60
    }
  }
}
