# Copy to .env.local (gitignored) for local dev:  cp .env.example .env.local
# (Windows PowerShell: Copy-Item .env.example .env.local)

# --- Browser (public-safe; bundled into the client) ---
# Supabase Dashboard -> Project Settings -> API: Project URL + publishable (or legacy anon) key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Server only (only needed to test invite signup locally via `npm run dev`) ---
# Never prefix these with VITE_ and never commit real values.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
